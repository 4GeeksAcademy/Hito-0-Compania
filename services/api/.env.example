JWT_SECRET=changeme
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Minutos de vigencia del token de restablecimiento de contraseña
PASSWORD_RESET_EXPIRE_MINUTES=30

# URL base del frontend, usada para armar el enlace de /reset-password
FRONTEND_URL=http://localhost:3000

# Resend (https://resend.com) - servicio de correo transaccional
RESEND_API_KEY=re_changeme
RESEND_FROM_EMAIL=onboarding@resend.dev

# Máximo de solicitudes de /auth/forgot-password por email por hora (rate limiting)
PASSWORD_RESET_RATE_LIMIT_PER_HOUR=3
